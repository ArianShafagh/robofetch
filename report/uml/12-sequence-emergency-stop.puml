' =====================================================================
' RoboFetch - Scenario 3 of 3: the operator halts a running order.
'
' ONE lifeline for the task manager, because it is one component. The
' two threads inside it are drawn as two overlapping execution
' occurrences on that lifeline, which is what UML uses for concurrent
' execution within a single participant. The outer bar is the worker,
' blocked on a navigation result; the inner bar is the subscription
' callback, which is why the stop can act while the worker cannot.
' =====================================================================
@startuml
skinparam backgroundColor White
skinparam shadowing false
skinparam sequence {
  ArrowColor #34495E
  LifeLineBorderColor #7F8C8D
  ParticipantBorderColor #34495E
  ParticipantBackgroundColor #FBFCFE
  LifeLineBackgroundColor #EAF2FA
}

actor Controller as C
participant "Web tier" as API
database "SQLite" as DB
participant "Task manager" as TM
participant "Nav2" as NAV
participant "Gazebo" as GZ

activate TM
TM -> NAV ++ : navigate to delivery_1
note right of TM : worker thread:\nblocked until Nav2 answers

== The button is pressed ==
C -> API ++ : POST /estop
API -> TM : publish /robot/estop
activate TM #D6E4F0
note right of TM : callback thread:\nruns while the worker waits
API --> C -- : stopped

TM -> NAV : cancel the in-flight goal
NAV --> TM -- : CANCELED
TM -> GZ : /cmd_vel zero, held for 1 s
TM -> API ++ : order 4 FAILED\n"halted by the emergency stop"
TM -> API : queued orders FAILED, with a reason
API -> DB : update orders
API --> TM --
deactivate TM
deactivate TM

== It does not latch ==
C -> API ++ : POST /orders  the next order
API --> C -- : accepted, an ordinary order

@enduml
