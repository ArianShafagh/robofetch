' =====================================================================
' RoboFetch - Scenario 3 of 3: the operator halts a running order.
'
' Arrowheads carry meaning here. A filled head (->) is a synchronous
' call that the sender waits on: the HTTP request, and the web tier's
' direct call into the database. An open head (->>) is asynchronous:
' every ROS topic publish, which is fire-and-forget with no reply.
' The status messages therefore have NO return arrow - the web tier
' never answers the task manager, it only listens.
' =====================================================================
@startuml
skinparam backgroundColor White
skinparam shadowing false
skinparam sequence {
  ArrowColor #34495E
  LifeLineBorderColor #7F8C8D
  ParticipantBorderColor #34495E
  ParticipantBackgroundColor #FBFCFE
  LifeLineBackgroundColor #EAF2FA
}

actor Controller as C
participant "Web tier" as API
database "SQLite" as DB
participant "Task manager" as TM
participant "Nav2" as NAV
participant "Gazebo" as GZ

activate TM
TM ->> NAV ++ : navigate to delivery_1
NAV ->> GZ : /cmd_vel, 10 Hz while navigating

== The button is pressed ==
C -> API ++ : POST /estop
API ->> TM : publish /robot/estop
API --> C -- : stopped
TM ->> NAV : cancel the in-flight goal
NAV -->> TM -- : CANCELED
TM ->> GZ : /cmd_vel zero, republished\nat 10 Hz for 1 s
TM ->> API : order 4 FAILED\n"halted by the emergency stop"
activate API
TM ->> API : queued orders FAILED, with a reason
API -> DB : update orders
deactivate API
deactivate TM

== It does not latch ==
C -> API ++ : POST /orders  the next order
API --> C -- : accepted, an ordinary order

@enduml
