' =====================================================================
' RoboFetch - Scenario 3 of 3: the operator halts a running order.
' One lifeline and one execution occurrence per participant. The
' concurrency inside the task manager - the stop being handled on the
' subscription callback while the worker is blocked on a navigation
' result - is explained in the report text rather than drawn here.
' =====================================================================
@startuml
skinparam backgroundColor White
skinparam shadowing false
skinparam sequence {
  ArrowColor #34495E
  LifeLineBorderColor #7F8C8D
  ParticipantBorderColor #34495E
  ParticipantBackgroundColor #FBFCFE
  LifeLineBackgroundColor #EAF2FA
}

actor Controller as C
participant "Web tier" as API
database "SQLite" as DB
participant "Task manager" as TM
participant "Nav2" as NAV
participant "Gazebo" as GZ

activate TM
TM -> NAV ++ : navigate to delivery_1

== The button is pressed ==
C -> API ++ : POST /estop
API -> TM : publish /robot/estop
API --> C -- : stopped
TM -> NAV : cancel the in-flight goal
NAV --> TM -- : CANCELED
TM -> GZ : /cmd_vel zero, held for 1 s
TM -> API ++ : order 4 FAILED\n"halted by the emergency stop"
TM -> API : queued orders FAILED, with a reason
API -> DB : update orders
API --> TM --
deactivate TM

== It does not latch ==
C -> API ++ : POST /orders  the next order
API --> C -- : accepted, an ordinary order

@enduml
