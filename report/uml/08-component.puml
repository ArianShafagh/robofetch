' =====================================================================
' RoboFetch - Component diagram (UML 2)
'
'   port                interaction point on a component's boundary
'   ─(0─ IFoo           assembly connector: the required interface
'                       (socket) of one component meets the provided
'                       interface (ball) of another
'   port ── [part]      delegation connector, inside the Web Tier
'   <<use>>             a plain dependency, not an interface
'
' Only the Web Tier is opened, to show delegation once. Every other
' component is closed on purpose: what depends on it binds to its
' interfaces, not to its insides.
' =====================================================================
@startuml
skinparam backgroundColor White
skinparam shadowing false
skinparam componentStyle uml2
skinparam nodesep 30
skinparam ranksep 42
skinparam component {
  BackgroundColor #FBFCFE
  BorderColor #34495E
  ArrowColor #34495E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #34495E
}
skinparam database {
  BackgroundColor #F4F6F8
  BorderColor #7F8C8D
}

actor "Controller /\nadministrator" as USER

component "Web Tier   <<robofetch_bridge>>" as WEB {
  portin  "http" as p_http
  portout "ai"   as p_ai
  portout "ros"  as p_ros

  [app.py\nroutes, sessions] as APP
  [admission.py\ncost + 5 gates] as ADM
  [db.py\nrepository] as DBR
  [predictor.py] as PRED
  [ros_link.py] as LINK

  p_http -- APP
  APP --> DBR
  APP --> ADM
  APP --> LINK
  ADM --> PRED
  PRED -- p_ai
  LINK -- p_ros
}

database "robofetch.db" as SQLITE
component "AI Service\n<<robofetch_ai>>" as AI
component "Task Manager\n<<robofetch_core>>" as TM {
  portin  "orders"  as p_orders
  portout "actuate" as p_act
}
component "Condition Monitor\n<<robofetch_core>>" as RSN
component "Gripper Node\n<<robofetch_core>>" as GN
component "Nav2\n<<third party>>" as NAV
component "Gazebo Harmonic\n<<third party>>" as GZ
component "robot_model.py\n<<shared physics>>" as RM

' ------------------------------------------------------ assembly connectors
USER -(0- p_http : IWebUI
p_ai -(0- AI : IPredict
p_ros -(0-  p_orders : IOrderQueue
p_ros -(0-  p_orders : IEstop
TM   -(0- p_ros : IOrderStatus
RSN  -(0- p_ros : ITelemetry
p_act -(0- GN  : IGrab
p_act -(0- NAV : INavigate
GN  -(0- GZ : ISimulation
NAV -(0- GZ : ISimulation

DBR --> SQLITE
ADM ..> RM : <<use>>
RSN ..> RM : <<use>>

@enduml
