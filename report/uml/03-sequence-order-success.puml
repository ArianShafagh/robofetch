' =====================================================================
' RoboFetch - Scenario 1 of 3: a controller orders a product and it is
' delivered. The normal path, end to end, with no branches: the decision
' is taken BEFORE the order is stored, and the delivery is confirmed
' against the simulator before it is reported complete.
' Figures are from the recorded acceptance run (order 1, SKU-1001).
' Arrowheads carry meaning: a filled head is a synchronous call the sender
' waits on; an open head is an asynchronous ROS topic publish, which gets no
' reply - which is why the status message has no return arrow.
' =====================================================================
@startuml
skinparam backgroundColor White
skinparam shadowing false
skinparam sequence {
  ArrowColor #34495E
  LifeLineBorderColor #7F8C8D
  ParticipantBorderColor #34495E
  ParticipantBackgroundColor #FBFCFE
  LifeLineBackgroundColor #EAF2FA
}


actor Controller as C
participant "Web tier" as API
database "SQLite" as DB
participant "AI service" as AI
participant "Task manager" as TM
participant "Nav2" as NAV
participant "Gripper" as GR
participant "Pose publisher\n(Gazebo)" as GZ

== Decide, before anything is stored ==
C -> API ++ : POST /preview  SKU-1001 -> delivery_1
API -> DB ++ : product, pick point, bay
DB --> API -- : 0.6 kg, (-3.0, 0.95), (-3.0, -2.2)
API -> AI ++ : predict  battery 100%, 0.6 kg, 8.6 m
AI --> API -- : feasible
API --> C -- : accepted, 3.71 Wh

== Confirm ==
C -> API ++ : POST /confirm
API -> DB : create order 1, reserve its energy
API ->> TM ++ : publish /orders/new
API --> C -- : order 1, pending

== Execute ==
TM -> NAV ++ : navigate to the pick point
NAV --> TM -- : SUCCEEDED
TM -> GR ++ : grab(parcel_1)
GR --> TM -- : joint reports "attached"
TM -> NAV ++ : navigate to delivery_1
NAV --> TM -- : SUCCEEDED
TM -> GR ++ : release(parcel_1)
GR --> TM -- : joint reports "detached"

== Confirm against the simulator ==
GZ -->> TM : parcel_1 at (-2.61, -1.94)
TM ->> API : status completed\n"delivered (0.47 m from target)"
activate API
API -> DB : update order + delivery history
deactivate API
deactivate TM

@enduml
