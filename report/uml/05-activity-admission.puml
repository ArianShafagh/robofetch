' =====================================================================
' RoboFetch - Activity diagram: order admission (complex feature C2)
'
' Corrects one ordering error and one omission in 05-activity-admission.puml:
'   1. The robot's condition must be READ AND PROJECTED FORWARD before any
'      cost can be estimated - estimate()/simulate_route() take the
'      projected condition as an input, so "read robot condition" cannot
'      happen after "estimate energy" the way the original diagram drew it.
'   2. The RESERVATION LEDGER (project() rolling the robot's state past
'      work already accepted and not yet finished) was missing entirely,
'      even though admission.py's own module docstring names it as one of
'      the two reasons this is defended as a complex feature rather than a
'      simple formula.
'
' The gate ORDER is still the point of the diagram: the physical checks
' run first, so the classifier can only ever refuse an order the physics
' already allowed - it can never approve one they rejected.
' Source: robofetch_bridge/admission.py (decide, project, estimate)
' =====================================================================
@startuml
skinparam backgroundColor White
skinparam shadowing false
skinparam activity {
  BackgroundColor #FBFCFE
  BorderColor #34495E
  ArrowColor #34495E
  DiamondBackgroundColor #FDF6E3
  DiamondBorderColor #34495E
}

start
:Receive product_id and delivery_id;
:Look up product\n(weight, pick point);
:Look up destination bay;
:Read the LIVE robot condition\n(battery, temperature, condition);

partition "Reservation ledger" {
  :Sum energy + peak temperature of every\norder still in flight (pending ... releasing);
  :Project the robot forward past that\nwork - NOT the live reading alone;
  note right
    Without this, two orders accepted while
    the robot is still busy would both be
    judged against the same battery, letting
    them together commit more than the pack
    holds.
  end note
}

:Compute the three route legs\n(empty leg to pick, loaded leg to bay,\nempty leg home);
:Cost the empty and loaded legs\nseparately at the PROJECTED condition;
:Forward-simulate the condition model\nover both legs to find peak temperature;

if (stock available?) then (no)
  :REFUSE\n"out of stock";
  stop
endif

if (battery after the job\nand the return leg\nstays above the reserve?) then (no)
  :REFUSE\n"could not return to the station";
  stop
endif

if (predicted peak temperature\nbelow the limit?) then (no)
  :REFUSE\n"would overheat";
  stop
endif

if (condition above the\nmaintenance floor?) then (no)
  :REFUSE\n"maintenance required";
  stop
endif

partition "Learned verdict" {
  if (AI service reachable?) then (yes)
    :Build the feature vector\n(battery, temperature, condition,\npayload, route distance);
    :Call the classifier;
    if (classifier says feasible?) then (no)
      :REFUSE\n"predicted infeasible";
      stop
    endif
    :decided_by = model;
  else (no)
    :Fall back to the deterministic\nmodel alone (NFR2);
    :decided_by = policy;
  endif
}

:ACCEPT\nstore the order with its estimate;
:Publish to the robot;
stop

@enduml
