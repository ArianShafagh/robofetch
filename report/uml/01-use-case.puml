' =====================================================================
' RoboFetch - Use case diagram
' Two human actors plus the simulation stack as a supporting actor.
' The two actors are the two roles the login enforces: an administrator
' can do everything a controller can, which is why it generalises it
' rather than being drawn with a duplicate set of arrows.
' Source: docs/proposal.md section 4, requirements FR1-FR21.
' =====================================================================
@startuml
skinparam backgroundColor White
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FBFCFE
  BorderColor #34495E
}
skinparam actorStyle awesome

title RoboFetch Use Cases

left to right direction

actor "Controller" as client
actor "Administrator" as admin
actor "Nav2 + Gazebo\n(supporting system)" as sim

admin --|> client

rectangle "RoboFetch" {
  usecase "UC1\nBrowse product catalogue" as UC1
  usecase "UC2\nRequest order preview" as UC2
  usecase "UC3\nConfirm an order" as UC3
  usecase "UC4\nView order history" as UC4
  usecase "UC5\nExecute a delivery" as UC5
  usecase "UC6\nView analytics" as UC6
  usecase "UC7\nView robot condition" as UC7
  usecase "UC8\nBrowse the database" as UC8
  usecase "UC9\nPredict order feasibility" as UC9
  usecase "UC10\nReturn robot to station" as UC10
  usecase "UC11\nStop the robot" as UC11
  usecase "UC12\nSign in" as UC12
  usecase "UC13\nManage products and layout" as UC13
}

client --> UC1
client --> UC2
client --> UC3
client --> UC4
client --> UC7
client --> UC10
client --> UC11
client --> UC12

admin --> UC6
admin --> UC8
admin --> UC13

UC2 ..> UC9 : <<include>>
UC3 ..> UC2 : <<include>>
UC3 ..> UC5 : <<trigger>>
UC10 ..> UC5 : <<queued behind>>
UC5 --> sim
UC11 --> sim

@enduml
