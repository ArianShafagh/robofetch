# colcon build artefacts - regenerated by `colcon build`
build/
install/
log/

# Python virtual environment (recreate with --system-site-packages, see HANDOVER 2)
robofetch_venv/

# Runtime state, not source: the orders/locations database is created on first run
*.db

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Editor
.vscode/

# Per-run telemetry logs and the synthetic training set. Both are regenerated: the logs by
# every launch, the CSV by tools/ml/generate.py. The trained model.joblib IS committed,
# because the running system depends on it while the generator is meant to be deleted.
logs/
tools/ml/runs.csv

# A friend's report, kept locally as a formatting reference only - not our work to commit.
Report Example/

# Downloaded tool, not source. Fetch it from plantuml.com/download if you need to re-render.
tools/report/plantuml.jar

# Report archives you zip for Overleaf - rebuild with: zip -r report.zip report/
report*.zip

# Windows alternate-data-stream metadata, created every time a file crosses the WSL boundary
# (screenshots, mostly). Never content.
*:Zone.Identifier
