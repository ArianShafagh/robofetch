<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robofetch_description</name>
  <version>0.1.0</version>
  <description>RoboFetch robot description: custom differential-drive robot with 2D lidar and gripper link.</description>
  <maintainer email="shafagh.arian2003@gmail.com">robojazzy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime deps: xacro expands the .xacro into URDF; robot_state_publisher broadcasts link TFs. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
