<?xml version="1.0"?>
<package format="3">
  <name>robofetch_bridge</name>
  <version>0.1.0</version>
  <description>FastAPI + SQLite web tier bridging clients to the RoboFetch ROS 2 system.</description>
  <maintainer email="shafagh.arian2003@gmail.com">robojazzy</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <!-- admission.py imports robofetch_core.robot_model: the condition model is
       shared between the web tier, the robot node and the ML data generator so
       there is exactly one definition of the physics. -->
  <exec_depend>robofetch_core</exec_depend>
  <exec_depend>python3-jinja2</exec_depend>
  <!-- FastAPI needs this to parse the HTML form posts. -->
  <exec_depend>python3-multipart</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
